{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lugano-clothing",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "images": {
    "binding": "IMAGES"
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lugano-clothing-production",
      "database_id": "8a021ec5-0794-4705-9662-461296114070"
    }
  ],
  "observability": {
    "enabled": true
  },
  "triggers": { "crons": ["*/5 * * * *"] }
}
